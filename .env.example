# ============================================
# 漫剧工作室 环境变量配置
# 复制此文件为 .env 并填入真实密钥
# ============================================

# --- 必需：Ark API Key（火山引擎）---
ARK_API_KEY=ark-xxxxxxxxxx

# --- 可选：Cloudflare R2 对象存储（推荐，配置后优先使用）---
# R2_ACCOUNT_ID=50b0f6d41fb1638bec484ffd6e9d49ca
# R2_ACCESS_KEY_ID=xxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxx
# R2_BUCKET=image-web-storage
# R2_PUBLIC_BASE=https://你的R2公开域名

# --- 可选：TOS 对象存储（R2 未配置时兜底）---
TOS_AK=AKLTxxxxxxxxxx
TOS_SK=xxxxxxxxxx

# --- 可选：Nano-GPT API Key（图生视频/图片生成备用通道）---
# NANO_GPT_API_KEY=sk-nano-xxxxxxxxxx

# --- 可选：Supabase 持久化（推荐 Railway 上配置，避免历史丢失）---
# SUPABASE_URL=https://你的项目.supabase.co
# SUPABASE_SERVICE_KEY=你的 service_role key

# --- 可选：第三方模型 API ---
# THIRD_PARTY_API_BASE=https://your-api.example.com/v1
# THIRD_PARTY_API_KEY=sk-xxxxxxxxxx

# --- 可选：登录密码（不设置则无需登录）---
# LOGIN_PASSWORD=your-password-here

# --- 可选：应用密钥（用于 session 加密）---
# APP_SECRET_KEY=your-random-secret-key

# --- 可选：上传大小限制（MB），默认512 ---
# MAX_UPLOAD_MB=512
